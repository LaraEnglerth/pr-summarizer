# Token de acesso pessoal do GitHub
# Como obter: github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Escopo necessário: repo
GITHUB_TOKEN=ghp_seuTokenAqui

# Chave da API da Anthropic (modelo Claude)
# Como obter: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-seuTokenAqui